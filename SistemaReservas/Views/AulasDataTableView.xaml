<UserControl Style="{StaticResource {x:Type UserControl}}" x:Class="SistemaReservas.Views.AulasDataTableView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:b="clr-namespace:SistemaReservas.Behaviors" b:ViewCommands.LoadedCommand="{Binding ActualizarCommand}">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <Grid Margin="0,0,0,24"><StackPanel><TextBlock Text="Aulas" Style="{StaticResource PageTitle}" /><TextBlock Text="Consulta de aulas · DataTable" Style="{StaticResource Subtitle}" /></StackPanel><Button Content="↻  Actualizar" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource SecondaryButton}" Command="{Binding ActualizarCommand}" /></Grid>
  <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0"><DataGrid ItemsSource="{Binding AulasDataTable.DefaultView}"><DataGrid.Columns><DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="CÓDIGO" Binding="{Binding AulaId}" Width="110" /><DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="AULA" Binding="{Binding Nombre}" Width="*" /><DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="CAPACIDAD" Binding="{Binding Capacidad}" Width="180" /></DataGrid.Columns></DataGrid></Border>
  <TextBlock Grid.Row="2" Text="{Binding Estado}" Style="{StaticResource Subtitle}" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite" />
 </Grid>
</UserControl>
