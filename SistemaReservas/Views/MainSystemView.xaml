<Window x:Class="SistemaReservas.Views.MainSystemView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sistema de Reservas"
        Height="650"
        Width="1000">


    <Grid>


        <Grid.RowDefinitions>

            <RowDefinition Height="70"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>



        <!-- CABECERA -->

        <Border
            Background="#1F4E79">


            <TextBlock
                Text="Sistema de Reservas"
                Foreground="White"
                FontSize="28"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"/>


        </Border>




        <!-- CONTENIDO -->


        <TabControl
            Grid.Row="1"
            Margin="15">



            <TabItem Header="Inicio">


                <Grid>


                    <TextBlock
                        Text="Bienvenido al sistema de reservas"
                        FontSize="30"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>


                </Grid>


            </TabItem>





            <TabItem Header="Aulas">


                <Grid>


                    <TextBlock
                        Text="Módulo de Aulas"
                        FontSize="25"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>


                </Grid>


            </TabItem>






            <TabItem Header="Reservas">


                <Grid>


                    <TextBlock
                        Text="Módulo de Reservas"
                        FontSize="25"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>


                </Grid>


            </TabItem>






            <TabItem Header="Nueva Reserva">


                <Grid>


                    <TextBlock
                        Text="Registrar nueva reserva"
                        FontSize="25"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>


                </Grid>


            </TabItem>



        </TabControl>



    </Grid>


</Window>