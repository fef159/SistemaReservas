<UserControl Style="{StaticResource {x:Type UserControl}}" x:Class="SistemaReservas.Views.ReservasView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:b="clr-namespace:SistemaReservas.Behaviors" b:ViewCommands.LoadedCommand="{Binding ActualizarCommand}">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,26"><TextBlock Text="PLANIFICACIÓN / AGENDA" Style="{StaticResource Eyebrow}" /><TextBlock Text="Reservas" Style="{StaticResource PageTitle}" /><TextBlock Text="Consulta las actividades programadas y los espacios asignados." Style="{StaticResource Subtitle}" /></StackPanel>
  <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20" Margin="0,0,0,20">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="Buscar por aula, responsable o motivo" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8" /><TextBox x:Name="SearchBox" AutomationProperties.Name="Buscar reservas por aula, responsable o motivo" Text="{Binding Busqueda, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
    <Button x:Name="RefreshButton" Grid.Column="1" Content="↻  Actualizar" Style="{StaticResource SecondaryButton}" Margin="12,24,0,0" Command="{Binding ActualizarCommand}" />
   </Grid>
  </Border>
  <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="66" /><RowDefinition Height="*" /><RowDefinition Height="48" /></Grid.RowDefinitions>
    <Grid Margin="22,0"><TextBlock Text="Agenda de reservas" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" /><TextBlock x:Name="CountLabel" Text="{Binding Resumen}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Muted}" /></Grid>
    <DataGrid x:Name="ReservationsGrid" Grid.Row="1" Margin="1,0" AutomationProperties.Name="Agenda de reservas" ItemsSource="{Binding ReservasDataTable.DefaultView}">
     <DataGrid.Columns>
      <DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="FECHA" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy}" Width="120" />
      <DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="HORA" Binding="{Binding Hora, Converter={StaticResource TimeDisplay}}" Width="85" />
      <DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="AULA" Binding="{Binding Aula}" Width="190" />
      <DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="RESPONSABLE" Binding="{Binding Usuario}" Width="180" />
      <DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="MOTIVO" Binding="{Binding Motivo}" Width="*" MinWidth="180" />
     </DataGrid.Columns>
    </DataGrid>
    <TextBlock x:Name="EmptyLabel" Grid.Row="1" Text="{Binding MensajeVacio}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Muted}" TextWrapping="Wrap" MaxWidth="430" Margin="24" TextAlignment="Center" Visibility="{Binding MostrarMensaje, Converter={StaticResource BooleanToVisibility}}" />
    <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="22,0"><TextBlock x:Name="StatusLabel" Text="{Binding Estado}" VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" /></Border>
   </Grid>
  </Border>
 </Grid>
</UserControl>
