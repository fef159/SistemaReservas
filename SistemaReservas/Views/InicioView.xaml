<UserControl Style="{StaticResource {x:Type UserControl}}" x:Class="SistemaReservas.Views.InicioView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:b="clr-namespace:SistemaReservas.Behaviors" b:ViewCommands.LoadedCommand="{Binding ActualizarCommand}">
 <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel>
   <TextBlock Text="TU ESPACIO DE TRABAJO" Style="{StaticResource Eyebrow}" />
   <TextBlock Text="Todo listo para organizar tu día." Style="{StaticResource PageTitle}" />
   <TextBlock Text="Una vista general de tus espacios y de la programación de hoy." Style="{StaticResource Subtitle}" Margin="0,0,0,26" />
   <Border Background="#E5F2EE" BorderBrush="#CDE6DD" BorderThickness="1" CornerRadius="12" Padding="22" Margin="0,0,0,20">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,24,0"><TextBlock Text="El lugar correcto para cada actividad." FontSize="23" FontWeight="SemiBold" Foreground="#155C50" TextWrapping="Wrap" /><TextBlock Text="Explora las aulas y consulta su capacidad antes de planificar." Foreground="#477166" TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="22" /></StackPanel>
     <Button Grid.Column="1" Content="Explorar aulas    →" VerticalAlignment="Center" Command="{Binding VerAulasCommand}" />
    </Grid>
   </Border>
   <UniformGrid Columns="3" Margin="0,0,0,20">
    <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,12,0"><StackPanel><TextBlock Text="AULAS REGISTRADAS" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}" /><TextBlock x:Name="AulasCount" Text="{Binding TotalAulas}" FontSize="32" FontWeight="SemiBold" Margin="0,8,0,4" /><TextBlock Text="Espacios para tus actividades" Style="{StaticResource Subtitle}" FontSize="12" /></StackPanel></Border>
    <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,12,0"><StackPanel><TextBlock Text="RESERVAS PARA HOY" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}" /><TextBlock x:Name="TodayCount" Text="{Binding ReservasHoy}" FontSize="32" FontWeight="SemiBold" Margin="0,8,0,4" /><TextBlock Text="Actividades en la agenda" Style="{StaticResource Subtitle}" FontSize="12" /></StackPanel></Border>
    <Border Style="{StaticResource Card}" Padding="20"><StackPanel><TextBlock Text="CAPACIDAD TOTAL" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}" /><TextBlock x:Name="CapacityCount" Text="{Binding CapacidadTotal}" FontSize="32" FontWeight="SemiBold" Margin="0,8,0,4" /><TextBlock Text="Personas entre todas las aulas" Style="{StaticResource Subtitle}" FontSize="12" /></StackPanel></Border>
   </UniformGrid>
   <Grid Margin="0,0,0,14"><TextBlock Text="Agenda de hoy" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" /><Button Content="Ver todas las reservas  →" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Command="{Binding VerReservasCommand}" /></Grid>
   <Border Style="{StaticResource Card}" Padding="0">
    <Grid MinHeight="150">
     <DataGrid x:Name="TodayGrid" MaxHeight="176" RowHeight="44" ItemsSource="{Binding AgendaHoy}"><DataGrid.Columns><DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="HORA" Binding="{Binding Hora, Converter={StaticResource TimeDisplay}}" Width="100" /><DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="AULA" Binding="{Binding Aula}" Width="150" /><DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="ACTIVIDAD" Binding="{Binding Motivo}" Width="*" MinWidth="180" /><DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="RESPONSABLE" Binding="{Binding Usuario}" Width="190" /></DataGrid.Columns></DataGrid>
     <TextBlock x:Name="EmptyLabel" Text="{Binding MensajeVacio}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24" TextWrapping="Wrap" Visibility="{Binding MostrarMensaje, Converter={StaticResource BooleanToVisibility}}" />
    </Grid>
   </Border>
   <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="StatusLabel" Text="{Binding Estado}" Style="{StaticResource Subtitle}" FontSize="12" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" /><Button Grid.Column="1" x:Name="RefreshButton" Content="↻  Actualizar" Style="{StaticResource SecondaryButton}" FontSize="12" Command="{Binding ActualizarCommand}" /></Grid>
  </StackPanel>
 </ScrollViewer>
</UserControl>
