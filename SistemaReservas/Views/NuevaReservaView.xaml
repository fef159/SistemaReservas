<UserControl Style="{StaticResource {x:Type UserControl}}" x:Class="SistemaReservas.Views.NuevaReservaView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
  <TextBlock Text="PLANIFICACIÓN / NUEVA RESERVA" Style="{StaticResource Eyebrow}" />
  <TextBlock Text="Nueva reserva" Style="{StaticResource PageTitle}" />
  <TextBlock Text="Prepara los detalles de tu próxima actividad." Style="{StaticResource Subtitle}" Margin="0,0,0,28" />
  <Border Style="{StaticResource Card}" Padding="32">
   <StackPanel>
    <Border Background="#FFF3D9" CornerRadius="5" Padding="12,6" HorizontalAlignment="Left"><TextBlock Text="REGISTRO PENDIENTE DE HABILITAR" Foreground="#8A651C" FontSize="10" FontWeight="SemiBold" /></Border>
    <TextBlock Text="Empieza por encontrar tu espacio." FontSize="26" FontWeight="SemiBold" Margin="0,24,0,12" TextWrapping="Wrap" />
    <TextBlock Text="El registro de nuevas reservas aún no está implementado en esta versión. Puedes consultar las aulas y la agenda existente para planificar tu actividad." Style="{StaticResource Subtitle}" MaxWidth="650" HorizontalAlignment="Left" />
    <Border Background="{StaticResource Canvas}" CornerRadius="8" Padding="24" Margin="0,28,0,28">
     <StackPanel><TextBlock Text="Ten a mano estos datos" FontWeight="SemiBold" Margin="0,0,0,16" /><TextBlock Text="01   El aula y la cantidad de participantes&#xA;02   La fecha y la hora de la actividad&#xA;03   El responsable y el motivo de la reserva" Foreground="{StaticResource Muted}" LineHeight="30" TextWrapping="Wrap" /></StackPanel>
    </Border>
    <WrapPanel><Button Content="Explorar aulas    →" Margin="0,0,12,12" Command="{Binding VerAulasCommand}" /><Button Content="Consultar reservas" Style="{StaticResource SecondaryButton}" Margin="0,0,0,12" Command="{Binding VerReservasCommand}" /></WrapPanel>
   </StackPanel>
  </Border>
 </StackPanel></ScrollViewer>
</UserControl>
