<UserControl Style="{StaticResource {x:Type UserControl}}" x:Class="SistemaReservas.Views.ShellView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:SistemaReservas.ViewModels">
 <Grid Background="{StaticResource Canvas}">
  <Grid.ColumnDefinitions><ColumnDefinition Width="224" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
  <Border Background="#142E3C">
   <Grid Margin="18,30,18,20">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel Margin="14,0,0,38">
     <StackPanel Orientation="Horizontal"><Border Background="#139884" CornerRadius="9" Width="36" Height="36"><TextBlock Text="R" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="RESERVA" Foreground="White" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" /></StackPanel>
     <TextBlock Text="Gestión de espacios" Foreground="#9FB6C4" FontSize="12" Margin="0,12,0,0" />
    </StackPanel>
    <StackPanel Grid.Row="1">
     <TextBlock Text="ESPACIO DE TRABAJO" FontSize="10" FontWeight="SemiBold" Foreground="#8FA8B7" Margin="16,0,0,14" />
     <Button x:Name="InicioButton" Style="{StaticResource NavigationButton}" Command="{Binding NavegarCommand}" CommandParameter="{x:Static vm:Pagina.Inicio}" Tag="{Binding EsInicio}"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="" Margin="0,0,14,0" /><TextBlock Text="Inicio" /></StackPanel></Button>
     <Button x:Name="AulasButton" Style="{StaticResource NavigationButton}" Command="{Binding NavegarCommand}" CommandParameter="{x:Static vm:Pagina.Aulas}" Tag="{Binding EsAulas}"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="" Margin="0,0,14,0" /><TextBlock Text="Aulas" /></StackPanel></Button>
     <Button x:Name="ReservasButton" Style="{StaticResource NavigationButton}" Command="{Binding NavegarCommand}" CommandParameter="{x:Static vm:Pagina.Reservas}" Tag="{Binding EsReservas}"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="" Margin="0,0,14,0" /><TextBlock Text="Reservas" /></StackPanel></Button>
     <Border Height="1" Background="#2A4351" Margin="14,22" />
     <Button x:Name="NuevaButton" Content="+   Nueva reserva" Command="{Binding NavegarCommand}" CommandParameter="{x:Static vm:Pagina.NuevaReserva}" />
    </StackPanel>
    <Border Grid.Row="2" BorderBrush="#2A4351" BorderThickness="0,1,0,0" Padding="14,20,0,0"><StackPanel><TextBlock Text="SISTEMA DE RESERVAS" Foreground="#C8D7E0" FontSize="10" FontWeight="SemiBold" /><TextBlock Text="Organiza mejor cada espacio." Foreground="#8FA8B7" FontSize="11" Margin="0,6,0,0" /></StackPanel></Border>
   </Grid>
  </Border>
  <Grid Grid.Column="1">
   <Grid.RowDefinitions><RowDefinition Height="76" /><RowDefinition Height="*" /></Grid.RowDefinitions>
   <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="32,0">
    <Grid><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Espacio de trabajo" Foreground="{StaticResource Muted}" /><TextBlock Text=" / " Foreground="#BBC8D0" Margin="12,0" /><TextBlock x:Name="PageName" Text="{Binding TituloPagina}" FontWeight="SemiBold" /></StackPanel><TextBlock x:Name="DateLabel" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="12" Text="{Binding FechaActual}" /></Grid>
   </Border>
   <ContentControl x:Name="ContenedorPagina" Grid.Row="1" Margin="32,28,32,24" Content="{Binding Contenido}" />
  </Grid>
 </Grid>
</UserControl>
