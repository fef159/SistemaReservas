<Window x:Class="SistemaReservas.Views.MenuView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Menú Principal"
        Height="500"
        Width="700">


    <Grid>


        <StackPanel
            VerticalAlignment="Center"
            HorizontalAlignment="Center">


            <TextBlock
                Text="Sistema de Reservas"
                FontSize="32"
                HorizontalAlignment="Center"
                Margin="0,0,0,30"/>



            <Button
                Content="Aulas - DataTable"
                Width="300"
                Height="40"
                Margin="10"
                Click="AulasDataTable_Click"/>



            <Button
                Content="Aulas - Objetos"
                Width="300"
                Height="40"
                Margin="10"
                Click="AulasObjetos_Click"/>



            <Button
                Content="Reservas - DataTable"
                Width="300"
                Height="40"
                Margin="10"
                Click="ReservasDataTable_Click"/>



            <Button
                Content="Reservas - Objetos"
                Width="300"
                Height="40"
                Margin="10"
                Click="ReservasObjetos_Click"/>


        </StackPanel>


    </Grid>


</Window>