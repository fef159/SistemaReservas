<UserControl Style="{StaticResource {x:Type UserControl}}" x:Class="SistemaReservas.Views.ReservasObjetosView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:b="clr-namespace:SistemaReservas.Behaviors" b:ViewCommands.LoadedCommand="{Binding ActualizarCommand}">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <Grid Margin="0,0,0,24"><StackPanel><TextBlock Text="Reservas" Style="{StaticResource PageTitle}" /><TextBlock Text="Consulta de reservas · Objetos" Style="{StaticResource Subtitle}" /></StackPanel><Button Content="↻  Actualizar" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource SecondaryButton}" Command="{Binding ActualizarCommand}" /></Grid>
  <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0"><DataGrid ItemsSource="{Binding Reservas}"><DataGrid.Columns><DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="N.º" Binding="{Binding ReservaId}" Width="75" /><DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="AULA" Binding="{Binding AulaId}" Width="130" /><DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="RESPONSABLE" Binding="{Binding UsuarioId}" Width="160" /><DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="FECHA" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy}" Width="120" /><DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="HORA" Binding="{Binding Hora, Converter={StaticResource TimeDisplay}}" Width="90" /><DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="MOTIVO" Binding="{Binding Motivo}" Width="*" MinWidth="160" /></DataGrid.Columns></DataGrid></Border>
  <TextBlock Grid.Row="2" Text="{Binding Estado}" Style="{StaticResource Subtitle}" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite" />
 </Grid>
</UserControl>
